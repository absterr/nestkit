import { execFileSync } from "node:child_process";
import { createRequire } from "node:module";
import { dirname, resolve } from "node:path";

let binPath;
try {
  const require = createRequire(import.meta.url);
  const pkgPath = require.resolve("start-server-and-test/package.json");
  const pkg = require(pkgPath);
  binPath = resolve(dirname(pkgPath), pkg.bin["start-server-and-test"]);
} catch {
  console.error('Error: "start-server-and-test" is not installed.');
  process.exit(1);
}

const testCmd = process.argv.slice(2).join(" ");
if (!testCmd) {
  console.error("Error: No test command provided.");
  process.exit(1);
}

const port = process.env.PORT ?? "3000";
const baseUrl = process.env.BASE_URL ?? `http://127.0.0.1:${port}`;
const probeUrl = baseUrl.replace(/^http(s?):\/\//, "http$1-get://");
const isWin = process.platform === "win32";

/**
 * Spawns a test server and executes E2E tests against dynamic ports.
 * NOTE: Fails if the app or test command hardcodes a different port instead of using BASE_URL/PORT.
 */

try {
  execFileSync(
    process.execPath,
    [binPath, "start", probeUrl, isWin ? `"${testCmd}"` : testCmd],
    {
      stdio: "inherit",
      shell: isWin,
      env: {
        ...process.env,
        PORT: port,
        BASE_URL: baseUrl,
      },
    },
  );
} catch (error) {
  process.exit(error.status ?? 1);
}
